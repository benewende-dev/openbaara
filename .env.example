# ─── OpenBaara — variables d'environnement ───
# Copier en .env.local (dev) et configurer sur Vercel (prod).
# Ce fichier est gitignoré (.env*) — ne contient que des placeholders.

# Envoi d'e-mails (formulaires + confirmations de commande) — Resend
RESEND_API_KEY=
LEAD_TO_EMAIL=contact@openbaara.com
LEAD_FROM_EMAIL="OpenBaara <onboarding@resend.dev>"

# Paiement CinetPay (Mobile Money / carte) — boutique
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# URL publique du site (return_url / notify_url CinetPay).
# En prod, mettre l'URL réelle, ex. https://openbaara.com
# En dev, laisser vide (déduit de la requête).
NEXT_PUBLIC_SITE_URL=

# Base PostgreSQL (catalogue, prix, codes promo, commandes, console).
DATABASE_URL=

# Paiement instantané BCEAO (PI-SPI), via l'API Business de la banque d'OpenBaara.
# Vide = moyen désactivé. Les noms exacts dépendront de la documentation de la banque.
PISPI_API_BASE=
PISPI_CLIENT_ID=
PISPI_CLIENT_SECRET=
PISPI_MERCHANT_ALIAS=
PISPI_WEBHOOK_SECRET=
